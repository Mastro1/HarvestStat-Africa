{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "python scripts/download_data.py",
  "env": {
    "DATA_CACHE_ONLY": "true",
    "REACT_APP_API_BASE_URL": "/_/backend",
    "BACKEND_ROUTE_PREFIX": "/_/backend"
  },
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "entrypoint": ".",
      "framework": "create-react-app",
      "routePrefix": "/"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "index.py",
      "framework": "flask",
      "routePrefix": "/_/backend",
      "buildCommand": "python build.py",
      "maxDuration": 10,
      "memory": 1024,
      "includeFiles": ".cache/**"
    }
  }
}
